{
  "name": "flowspec",
  "version": "0.3.0",
  "description": "Immutable user flow specifications for the age of agentic coding",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "flowspec": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/queso/FlowSpec.git"
  },
  "keywords": [
    "testing",
    "e2e",
    "flow",
    "specs",
    "yaml",
    "claude",
    "ai"
  ],
  "author": "Josh Owens",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "test": "bun test --timeout 30000",
    "test:coverage": "bun test --coverage --timeout 30000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "pretest:e2e": "bun run build && chmod +x dist/index.js && mkdir -p node_modules/.bin && ln -sf ../../dist/index.js node_modules/.bin/flowspec",
    "test:e2e": "flowspec run specs/"
  },
  "dependencies": {
    "agent-browser": "0.9.3",
    "js-yaml": "^4.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/express": "^4.17.0",
    "@types/js-yaml": "^4.0.0",
    "express": "^4.18.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
